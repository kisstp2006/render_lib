#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D hdrImage;
layout(std430, set = 0, binding = 1) buffer ExposureResult
{
    float AverageLuminance;
} result;

shared float partial[256];

void main()
{
    uint threadIndex = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint sampleIndex = threadIndex; sampleIndex < 1024u; sampleIndex += 256u)
    {
        uvec2 cell = uvec2(sampleIndex & 31u, sampleIndex >> 5u);
        vec2 uv = (vec2(cell) + 0.5) / 32.0;
        vec3 color = textureLod(hdrImage, uv, 0.0).rgb;
        sum += dot(color, vec3(0.2126, 0.7152, 0.0722));
    }
    partial[threadIndex] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (threadIndex < stride)
            partial[threadIndex] += partial[threadIndex + stride];
        barrier();
    }
    if (threadIndex == 0u)
        result.AverageLuminance = max(partial[0] / 1024.0, 1e-4);
}
