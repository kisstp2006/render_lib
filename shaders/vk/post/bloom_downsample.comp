#version 460
#include "../../common/bloom_math.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D sourceImage;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D targetImage;
layout(push_constant) uniform BloomConstants { vec4 Parameters; } bloom;

vec3 Tap(vec2 uv, ivec2 offset)
{
    return textureLod(sourceImage, uv + vec2(offset) / vec2(textureSize(sourceImage, 0)), 0.0).rgb;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(targetImage);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 center = Tap(uv, ivec2(0));
    vec3 tl = Tap(uv, ivec2(-1, -1)), tr = Tap(uv, ivec2(1, -1));
    vec3 bl = Tap(uv, ivec2(-1, 1)), br = Tap(uv, ivec2(1, 1));
    vec3 t = Tap(uv, ivec2(0, -2)), l = Tap(uv, ivec2(-2, 0));
    vec3 r = Tap(uv, ivec2(2, 0)), b = Tap(uv, ivec2(0, 2));
    vec3 tlf = Tap(uv, ivec2(-2, -2)), trf = Tap(uv, ivec2(2, -2));
    vec3 blf = Tap(uv, ivec2(-2, 2)), brf = Tap(uv, ivec2(2, 2));
    bool firstPass = bloom.Parameters.x > 0.5;
    vec3 result = EngineBloomAverage(tl, tr, bl, br, firstPass) * 0.5
        + (EngineBloomAverage(tlf, t, l, center, firstPass)
        + EngineBloomAverage(trf, t, r, center, firstPass)
        + EngineBloomAverage(blf, b, l, center, firstPass)
        + EngineBloomAverage(brf, b, r, center, firstPass)) * 0.125;
    if (firstPass)
    {
        float luminance = EngineBloomLuminance(result) * bloom.Parameters.z;
        result *= clamp((luminance - bloom.Parameters.y) / max(luminance, 1e-4), 0.0, 1.0);
    }
    imageStore(targetImage, pixel, vec4(result, 1.0));
}
