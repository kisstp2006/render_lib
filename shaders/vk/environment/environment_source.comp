#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2DArray outputCube;
layout(set = 0, binding = 1) uniform sampler2D panorama;

layout(push_constant) uniform EnvironmentBakeConstants
{
    vec4 SunDirectionIntensity;
    vec4 SunColorAngularRadius;
    vec4 ZenithIntensity;
    vec4 HorizonCycle;
    vec4 GroundExposure;
    vec4 NightZenithIntensity;
    vec4 NightHorizonGlow;
    vec4 BakeParameters;
} pc;

#include "environment/environment_common.glsl"
#include "../../common/procedural_sky.glsl"

vec3 ProceduralRadiance(vec3 direction)
{
    vec3 toSun = normalize(-pc.SunDirectionIntensity.xyz);
    EngineProceduralSkyParameters parameters;
    parameters.ZenithColor = pc.ZenithIntensity.rgb;
    parameters.HorizonColor = pc.HorizonCycle.rgb;
    parameters.GroundColor = pc.GroundExposure.rgb;
    parameters.NightZenithColor = pc.NightZenithIntensity.rgb;
    parameters.NightHorizonColor = pc.NightHorizonGlow.rgb;
    parameters.SunColor = pc.SunColorAngularRadius.rgb;
    parameters.SkyIntensity = pc.ZenithIntensity.w;
    parameters.NightSkyIntensity = pc.NightZenithIntensity.w;
    parameters.NightHorizonGlow = pc.NightHorizonGlow.w;
    parameters.EnableDayNightCycle = pc.HorizonCycle.w > 0.5;
    vec3 color = EngineEvaluateProceduralSky(direction, toSun, parameters);
    color += EngineEvaluateBakedSun(
        direction, toSun, pc.SunColorAngularRadius.rgb,
        pc.SunDirectionIntensity.w, pc.SunColorAngularRadius.w);
    return color;
}

void main()
{
    ivec3 coordinate = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(outputCube);
    if (coordinate.x >= size.x || coordinate.y >= size.y || coordinate.z >= 6)
        return;
    vec2 uv = (vec2(coordinate.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 direction = CubeDirection(uint(coordinate.z), uv);
    vec3 color;
    if (pc.BakeParameters.w > 0.5)
    {
        float longitude = atan(direction.z, direction.x) + pc.BakeParameters.z;
        vec2 panoramaUv = vec2(fract(longitude / (2.0 * ENV_PI) + 0.5),
                               acos(clamp(direction.y, -1.0, 1.0)) / ENV_PI);
        color = max(textureLod(panorama, panoramaUv, 0.0).rgb, vec3(0.0)) * pc.GroundExposure.w;
    }
    else
        color = ProceduralRadiance(direction);
    imageStore(outputCube, coordinate, vec4(color, 1.0));
}
