{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux (Ninja, Release)",
            "description": "CI/CLI preset: single-config Ninja build, used by the Linux GitHub Actions job and local WSL/native Linux testing.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (Ninja, Release)",
            "description": "CI/CLI preset: single-config Ninja build using cl.exe from a Visual Studio developer environment (e.g. ilammy/msvc-dev-cmd). Independent of the installed Visual Studio version.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-vs2022",
            "displayName": "Windows (Visual Studio 2022 IDE)",
            "description": "Convenience preset for local IDE use with the most widely available public Visual Studio generator. Not used by CI.",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs2022",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux",
            "configurePreset": "linux"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        },
        {
            "name": "windows-vs2022",
            "configurePreset": "windows-vs2022",
            "configuration": "RelWithDebInfo"
        }
    ],
    "testPresets": [
        {
            "name": "linux",
            "configurePreset": "linux",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "windows-vs2022",
            "configurePreset": "windows-vs2022",
            "configuration": "RelWithDebInfo",
            "output": { "outputOnFailure": true }
        }
    ]
}
